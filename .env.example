# ===== Telegram =====
# Токен от @BotFather
BOT_TOKEN=

# Владелец бота (ваш Telegram user id, целым числом).
# Нужен для админ-команды /dbreset (полная очистка БД перед новым заливом).
# 0 или пусто = админ-команды отключены.
BOT_OWNER_ID=0

# ===== Прокси (если провайдер блокирует api.telegram.org) =====
# HTTP-прокси:  PROXY_URL=http://127.0.0.1:8080
# SOCKS5:       PROXY_URL=socks5://127.0.0.1:1080
PROXY_URL=

# ===== Каталог OSINT-ботов =====
# Не обязательно, бот работает и без этого
CATALOG_ENABLED=true

# ===== База данных =====
DB_URL=sqlite+aiosqlite:///./data/bot.db
# Для PostgreSQL: postgresql+asyncpg://user:password@host:5432/bot
LOG_LEVEL=INFO

# ===== Supabase (хранение импортированных БД, команда /import) =====
# URL проекта: https://xxxx.supabase.co
SUPABASE_URL=
# Service role key из Supabase → Settings → API (секрет, только на сервере)
SUPABASE_SERVICE_ROLE_KEY=
# Авто-создание таблиц (опционально): Project Ref + Personal Access Token (sbp_...)
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
# Каталог для загруженных файлов (относительно проекта)
UPLOAD_DIR=data/uploads

# ===== DataTech (параллельный поиск по внешним базам, best-effort) =====
# Пусто = не подключён. Задайте ключ, чтобы включить параллельный поиск.
DATATECH_API_KEY=
# Опционально: переопределить endpoint и режим запроса
DATATECH_BASE_URL=https://datatech.work/public-api/data/search
DATATECH_MODE=auto

# ===== OSINT-инструменты (Blackbird / Snoop), опционально =====
# На Render ставятся автоматически (см. Dockerfile). BLACKBIRD_DIR/SNOOP_DIR
# указывают на папку с инструментом; на Render они предзаданы ENV в образе.
# На локальной машине задайте пути, если хотите включить локальные провайдеры.
BLACKBIRD_DIR=
BLACKBIRD_PYTHON=
BLACKBIRD_FILTER=cat=social
BLACKBIRD_TIMEOUT=120
SNOOP_DIR=
SNOOP_PYTHON=
SNOOP_TIMEOUT=180
# Домены, по которым запрещено искать (заблокированы средой). Через запятую.
BLOCKED_HOSTS=instagram.com,youtube.com,youtu.be,files.fm,t.me,telegram.org,threads.net,tiktok.com

# ===== Соцсети =====
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GITHUB_TOKEN=
VK_SERVICE_TOKEN=
TWITTER_BEARER_TOKEN=

# ===== Веб-поиск (для /web и /find) =====
# Brave: brave.com/search/api — 2000 запросов/мес бесплатно
BRAVE_API_KEY=
# Serper: serper.dev — 2500 запросов на старте бесплатно
SERPER_API_KEY=
# SerpAPI: serpapi.com — 100 запросов/мес бесплатно
SERPAPI_API_KEY=

# ===== RSS-ленты для /find (через запятую) =====
RSS_FEEDS=https://habr.com/ru/rss/best/daily/,https://lenta.ru/rss/news

# ===== LLM (опционально) =====
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ===== Скрапинг =====
MAX_SCRAPE_PAGES=15
REQUEST_TIMEOUT=20.0
RATE_LIMIT_PER_SECOND=5.0

# ===== Импорт БД: лимиты распаковки архивов (ZIP/RAR) =====
# Максимум файлов внутри архивов
MAX_ARCHIVE_FILES=1000
# Максимальный суммарный объём распакованных данных, МБ
MAX_ARCHIVE_TOTAL_MB=1024

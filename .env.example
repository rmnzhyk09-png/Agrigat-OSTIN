# ===== Telegram =====
# Токен от @BotFather
BOT_TOKEN=

# ===== Прокси (если провайдер блокирует api.telegram.org) =====
# HTTP-прокси:  PROXY_URL=http://127.0.0.1:8080
# SOCKS5:       PROXY_URL=socks5://127.0.0.1:1080
PROXY_URL=

# ===== Каталог OSINT-ботов =====
# Не обязательно, бот работает и без этого
CATALOG_ENABLED=true

# ===== База данных =====
DB_URL=sqlite+aiosqlite:///./data/bot.db
# Для PostgreSQL: postgresql+asyncpg://user:password@host:5432/bot
LOG_LEVEL=INFO

# ===== Supabase (хранение импортированных БД, команда /import) =====
# URL проекта: https://xxxx.supabase.co
SUPABASE_URL=
# Service role key из Supabase → Settings → API (секрет, только на сервере)
SUPABASE_SERVICE_ROLE_KEY=
# Авто-создание таблиц (опционально): Project Ref + Personal Access Token (sbp_...)
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
# Каталог для загруженных файлов (относительно проекта)
UPLOAD_DIR=data/uploads

# ===== Соцсети =====
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GITHUB_TOKEN=
VK_SERVICE_TOKEN=
TWITTER_BEARER_TOKEN=

# ===== Веб-поиск (для /web и /find) =====
# Brave: brave.com/search/api — 2000 запросов/мес бесплатно
BRAVE_API_KEY=
# Serper: serper.dev — 2500 запросов на старте бесплатно
SERPER_API_KEY=
# SerpAPI: serpapi.com — 100 запросов/мес бесплатно
SERPAPI_API_KEY=

# ===== RSS-ленты для /find (через запятую) =====
RSS_FEEDS=https://habr.com/ru/rss/best/daily/,https://lenta.ru/rss/news

# ===== LLM (опционально) =====
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ===== Скрапинг =====
MAX_SCRAPE_PAGES=15
REQUEST_TIMEOUT=20.0
RATE_LIMIT_PER_SECOND=5.0
